# Hyperions MC — hyperionsmc.com
# Bloque para AÑADIR al final de /etc/caddy/Caddyfile del VPS (Contabo).
# Caddy obtiene y renueva el certificado HTTPS automáticamente (Let's Encrypt).

hyperionsmc.com {
        root * /var/www/hyperionsmc
        file_server
        encode gzip zstd

        header {
                Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src https://api.mcsrvstat.us; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
                X-Content-Type-Options "nosniff"
                X-Frame-Options "DENY"
                Referrer-Policy "strict-origin-when-cross-origin"
                Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
                Cross-Origin-Opener-Policy "same-origin"
                Cross-Origin-Resource-Policy "same-origin"
        }

        # Cache-Control: sin esto el navegador aplica frescura heuristica (RFC 7234 4.2.2)
        # y puede seguir sirviendo HTML/JS viejos de cache durante horas. Ya paso: un sale.js
        # con el descuento antiguo (50%) se sirvio de cache mientras la pagina anunciaba 20%.
        #
        # Se hace al reves de lo evidente. Un matcher `path *.html` NO casaria con /tienda/,
        # porque el sitio usa URLs limpias y la ruta de la peticion no lleva el index.html.
        # Por eso se define la lista de assets cacheables y todo lo demas revalida.
        @assets path *.webp *.png *.jpg *.jpeg *.svg *.ico *.woff *.woff2
        header @assets Cache-Control "public, max-age=31536000, immutable"

        # Paginas, JS y CSS cambian en cada despliegue y no llevan hash en el nombre:
        # no-cache significa "pregunta al servidor", no "no guardes nada" — con el Etag
        # que ya envia Caddy, la respuesta habitual sera un 304 barato.
        @revalida not path *.webp *.png *.jpg *.jpeg *.svg *.ico *.woff *.woff2
        header @revalida Cache-Control "no-cache"

}
